# Copy to .env and fill in. NEVER commit .env.
# Generate the secret values with:  python backend/scripts/generate_secrets.py

# ---- PostgreSQL (used by docker compose; also the DB credentials for local runs) ----
POSTGRES_USER=tgmigrate
POSTGRES_PASSWORD=replace-me-with-generated-password
POSTGRES_DB=tgmigrate
# Local (non-Docker) runs connect to localhost. docker compose overrides the host to "db" automatically.
DATABASE_URL=postgresql+asyncpg://tgmigrate:replace-me-with-generated-password@localhost:5432/tgmigrate

# ---- Telegram application credentials ----
# Create an application at https://my.telegram.org -> "API development tools". Server-side only.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=replace-me-your-telegram-api-hash

# ---- Secrets ----
# Fernet key(s), comma-separated. The FIRST encrypts; all can decrypt (key rotation). Losing every key means
# stored Telegram sessions become unreadable and accounts must be reconnected.
SESSION_ENCRYPTION_KEYS=replace-me-generated-fernet-key
JWT_SECRET=replace-me-generated-random-string-at-least-32-chars

# ---- App behaviour ----
# development | production (production refuses placeholder secrets)
APP_ENV=development
# set to false after you have created your admin account
ALLOW_REGISTRATION=true
# set to false to hide /docs in production
DOCS_ENABLED=true
# comma-separated browser origins for the Stage 3 frontend, e.g. http://localhost:5173
CORS_ORIGINS=
ACCESS_TOKEN_TTL_MINUTES=60

# ---- Stage 2: queue + migration engine ----
# Redis is the job queue (arq). docker compose overrides the host to "redis" automatically.
REDIS_URL=redis://localhost:6379/0
# Application-level throttling. NOTHING here overrides Telegram: its limits and FloodWaits stay authoritative.
# Members processed at once (1-5). Keep 1 unless you know what you are doing.
MIGRATION_CONCURRENCY=1
# Minimum seconds between the starts of Telegram operations for one migration.
MIGRATION_MIN_DELAY_SECONDS=5
# Retries for TRANSIENT errors only (network/server). Backoff 1,2,4,8... capped. Refusals are never retried.
MIGRATION_MAX_RETRIES=4
MIGRATION_RETRY_BASE_SECONDS=1
MIGRATION_RETRY_MAX_SECONDS=30
# This many members in a row failing transiently pauses the job (circuit breaker).
MIGRATION_MAX_CONSECUTIVE_FAILURES=5
# A job whose worker heartbeat is older than this is treated as orphaned and recovered.
MIGRATION_LEASE_SECONDS=120
# Migrations one worker process runs at the same time.
WORKER_MAX_JOBS=2
SSE_POLL_INTERVAL_SECONDS=1
SSE_HEARTBEAT_SECONDS=15

# ---- Bounds / policy (defaults shown) ----
ELIGIBILITY_DEFAULT_LIMIT=500
ELIGIBILITY_MAX_LIMIT=5000
MEMBER_FETCH_DEFAULT_LIMIT=200
MEMBER_FETCH_MAX_LIMIT=5000
DESTINATION_LISTING_LIMIT=5000
# waits shorter than this are honoured once; longer ones are surfaced as 429
MAX_INLINE_FLOOD_WAIT_SECONDS=5
# hard overall deadlines for Telegram calls so a stalled connection can never hang a request
TELEGRAM_LOGIN_TIMEOUT_SECONDS=30
TELEGRAM_OPERATION_TIMEOUT_SECONDS=120
